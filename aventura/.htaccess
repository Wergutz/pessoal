# Aventura Escoteira 2026 - Apache (Hostinger)

DirectoryIndex index.php

# Nao listar diretorios.
Options -Indexes

# Bloqueia o acesso direto ao codigo e ao banco.
RedirectMatch 404 ^/(src|data|testes)(/|$)

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|sql|md)$">
    Require all denied
</FilesMatch>

# Cabecalhos basicos de seguranca.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Cache dos estaticos.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

AddDefaultCharset UTF-8
